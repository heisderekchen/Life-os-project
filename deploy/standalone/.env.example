# Copy this file to .env on the server. Never commit the filled-in .env.
COMPOSE_PROJECT_NAME=happyspa-lifeos
LIFEOS_DOMAIN=
ENVIRONMENT=production
# Keep recurrence off during initial data migration and acceptance. Enable only
# after the historical recurrence ledger is imported and verified.
LIFEOS_RECURRENCE_ENABLED=false
# Supply these from the approved current private-workbench secret store.
# Keep them out of Git and do not paste them into chat or deployment logs.
AUTH_SECRET=
PERSONAL_WORKBENCH_ENTRY_KEY=
PERSONAL_WORKBENCH_OWNER=heisderek
# Optional only when initializing the existing owner password flow.
PERSONAL_WORKBENCH_OWNER_SETUP_ENABLED=false
PERSONAL_WORKBENCH_OWNER_SETUP_GRANT=
# Optional NEO read-only outbox receiver. Provision a unique secret through the
# approved server secret channel only after the receiver change is approved.
# The token grants POST access to exactly /workbench/api/happyspa-bench/outbox.
HAPPYSPA_BENCH_OUTBOX_TOKEN=

# Optional configurable internal workspaces for the unified login catalog.
# JSON array of {"id","slug","displayName","configured","applicationTarget"}.
# Workspaces left unconfigured render a safe not-configured screen; no business
# application is implied until an explicit applicationTarget is set.
PLATFORM_WORKSPACES_JSON=

# Optional private AI planner. Start it only after configuring all required
# values, then use: docker compose --profile ai up -d
AGENT_DB_PASSWORD=
AGENT_SERVICE_TOKEN=
WORKSPACE_SUBJECT_SIGNING_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_INPUT_USD_PER_MILLION=
DEEPSEEK_OUTPUT_USD_PER_MILLION=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
AGENT_MAX_BUDGET_USD=0.1
AGENT_MAX_OUTPUT_TOKENS=800
