  "narrative": {
    "northStar": "From structure to action",
    "overview": "This is an Operate-mode extension of the existing myOS interface. Preserve its sidebar, app header, typography, theme preferences, dialogs, and execution controls. The workspace adds a restrained teal selection language to neutral surfaces, thin dividers, and compact operational rows.\n\nThis document describes the project workspace only. Its split composition and graph geometry do not replace layout rules for other app modules. The approved direction is recorded in `.impeccable/surfaces/project-workspace.md`.",
    "keyCharacteristics": [
      "One filtered dataset and one selection across graph, table, and inspector.",
      "Dense rows with recognizable folder, topic, and document symbols.",
      "Existing theme and system font behavior, with a local workspace accent."
    ],
    "rules": [
      {
        "name": "The Local Accent Rule",
        "body": "Workspace selection tokens must stay scoped to this surface; neutral and shell tokens remain app-owned.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve one dataset, one selection, and the project → topic → task relationship.",
      "Do inherit the existing app shell, typography, neutral tokens, and full-detail controls.",
      "Do keep explicit Inbox and Unclassified states and persist ownership on the server.",
      "Do retain horizontal table scrolling, visible keyboard focus, and the phone touch-target floor."
    ],
    "donts": [
      "Don't infer ownership for existing unclassified records.",
      "Don't add decorative card grids, entrance animation, or new font assets to this workspace.",
      "Don't treat fixture screenshots as evidence of real-account acceptance or deployment.",
      "Don't apply this workspace composition or local accent globally."
    ]
  }
